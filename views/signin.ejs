<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign-In</title>
   <style>
        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(50px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.02); }
        }

        @keyframes shimmer {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }

        @keyframes glow {
            0%, 100% { 
                box-shadow: 0 0 20px rgba(59, 130, 246, 0.3),
                           0 0 40px rgba(168, 85, 247, 0.2),
                           0 15px 35px rgba(0, 0, 0, 0.3);
            }
            50% { 
                box-shadow: 0 0 30px rgba(59, 130, 246, 0.5),
                           0 0 60px rgba(168, 85, 247, 0.4),
                           0 20px 50px rgba(0, 0, 0, 0.4);
            }
        }

        @keyframes inputFocus {
            0% { width: 0%; }
            100% { width: 100%; }
        }

        @keyframes buttonPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        @keyframes sparkle {
            0%, 100% { opacity: 0; transform: scale(0) rotate(0deg); }
            50% { opacity: 1; transform: scale(1) rotate(180deg); }
        }

        @keyframes typewriter {
            from { width: 0; }
            to { width: 100%; }
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        /* Global Styling */
        * {
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(-45deg, #0f0f23, #1a1a2e, #16213e, #0f3460);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
            margin: 0;
            padding: 20px;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 80% 20%, rgba(168, 85, 247, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 40% 40%, rgba(34, 197, 94, 0.08) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

        .container {
            width: 100%;
            max-width: 450px;
            background: rgba(30, 30, 30, 0.9);
            backdrop-filter: blur(25px) saturate(180%);
            padding: 40px;
            border-radius: 25px;
            border: 1px solid rgba(59, 130, 246, 0.3);
            text-align: center;
            position: relative;
            animation: slideInUp 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards,
                       float 6s ease-in-out infinite,
                       glow 4s ease-in-out infinite;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5),
                        0 15px 25px rgba(59, 130, 246, 0.1),
                        inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, 
                transparent 30%, 
                rgba(59, 130, 246, 0.05) 50%, 
                transparent 70%);
            background-size: 200% 200%;
            animation: shimmer 3s infinite;
            border-radius: 25px;
            z-index: -1;
        }

        .container::after {
            content: '✨';
            position: absolute;
            top: 20px;
            right: 25px;
            font-size: 1.5rem;
            animation: sparkle 2s infinite;
            z-index: 2;
        }

        .container:hover {
            transform: translateY(-10px) scale(1.02);
            border-color: rgba(59, 130, 246, 0.6);
            box-shadow: 0 35px 70px rgba(0, 0, 0, 0.6),
                        0 25px 35px rgba(59, 130, 246, 0.3);
        }

        h2 {
            margin-bottom: 30px;
            background: linear-gradient(45deg, #3b82f6, #8b5cf6, #06d6a0);
            background-size: 300% 300%;
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientShift 3s ease infinite;
            font-weight: 700;
            font-size: 2.2rem;
            position: relative;
            overflow: hidden;
        }

        h2::after {
            content: '';
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #3b82f6;
            animation: blink 1s infinite;
        }

        .form-group {
            margin-bottom: 25px;
            position: relative;
            text-align: left;
        }

        label {
            font-weight: 600;
            display: block;
            margin-bottom: 8px;
            color: #cbd5e1;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .form-control {
            width: 100%;
            padding: 15px 20px;
            border: 2px solid rgba(59, 130, 246, 0.3);
            border-radius: 15px;
            font-size: 16px;
            background: rgba(40, 40, 40, 0.8);
            color: #e2e8f0;
            backdrop-filter: blur(10px);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            z-index: 2;
        }

        .form-control::placeholder {
            color: #64748b;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: rgba(59, 130, 246, 0.8);
            background: rgba(50, 50, 50, 0.9);
            box-shadow: 0 0 25px rgba(59, 130, 246, 0.3),
                        0 10px 20px rgba(0, 0, 0, 0.2);
            transform: translateY(-2px);
        }

        .form-control:focus::placeholder {
            color: transparent;
            transform: translateY(-20px);
        }

        .form-control:focus + .input-line {
            transform: scaleX(1);
        }

        .form-control:focus ~ label {
            color: #3b82f6;
            transform: translateY(-2px);
        }

        .input-line {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(45deg, #3b82f6, #8b5cf6);
            transform: scaleX(0);
            transition: transform 0.3s ease;
            border-radius: 1px;
        }

        .input-wrapper {
            position: relative;
            overflow: hidden;
        }

        .input-wrapper::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, 
                transparent, 
                rgba(59, 130, 246, 0.1), 
                transparent);
            transition: left 0.6s ease;
            z-index: 1;
            border-radius: 15px;
        }

        .form-control:focus ~ .input-wrapper::before {
            left: 100%;
        }

        button {
            width: 100%;
            background: linear-gradient(45deg, #3b82f6, #8b5cf6);
            color: white;
            border: none;
            padding: 18px;
            font-size: 18px;
            font-weight: 600;
            border-radius: 15px;
            cursor: pointer;
            margin-top: 25px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4);
        }

        button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s ease;
        }

        button:hover {
            background: linear-gradient(45deg, #2563eb, #7c3aed);
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 20px 40px rgba(59, 130, 246, 0.6);
            animation: buttonPulse 1s infinite;
        }

        button:hover::before {
            left: 100%;
        }

        button:active {
            transform: translateY(-1px) scale(1.01);
            transition: all 0.1s ease;
        }

        /* Additional Form Elements */
        .checkbox-wrapper {
            display: flex;
            align-items: center;
            margin: 20px 0;
            text-align: left;
        }

        .checkbox-wrapper input[type="checkbox"] {
            width: 20px;
            height: 20px;
            margin-right: 10px;
            accent-color: #3b82f6;
            transform: scale(1.2);
        }

        .checkbox-wrapper label {
            margin: 0;
            color: #cbd5e1;
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
        }

        /* Loading Animation */
        .loading {
            position: relative;
        }

        .loading::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            margin: auto;
            border: 2px solid transparent;
            border-top: 2px solid #ffffff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        @keyframes spin {
            0% { transform: translate(-50%, -50%) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg); }
        }

        /* Success Animation */
        .success {
            background: linear-gradient(45deg, #10b981, #059669) !important;
            animation: pulse 0.5s ease;
        }

        /* Responsive Design */
        @media (max-width: 500px) {
            .container {
                max-width: 95%;
                padding: 30px 25px;
                margin: 10px;
            }

            h2 {
                font-size: 1.8rem;
            }

            .form-control {
                padding: 12px 15px;
                font-size: 16px;
            }

            button {
                padding: 15px;
                font-size: 16px;
            }
        }

        @media (max-width: 350px) {
            .container {
                padding: 25px 20px;
            }

            h2 {
                font-size: 1.6rem;
            }
        }

        /* Accessibility */
        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
            
            .container {
                animation: slideInUp 0.3s ease forwards;
            }
        }

        /* Focus indicators for accessibility */
        button:focus,
        .form-control:focus {
            outline: 2px solid #3b82f6;
            outline-offset: 2px;
        }
    </style>
</head>
<body>
    <%- include("./partials/script") %>
    

    <div class="container">
        <h2>Sign In</h2>
        <div>
            <span><%= error || "" %></span>
        </div>
        <form action="/user/signin" method="post">
            <label for="exampleInputEmail1">Email address</label>
            <input type="email" class="form-control" id="exampleInputEmail1" name="email" required>
            
            <label for="exampleInputPassword1">Password</label>
            <input type="password" class="form-control" name="password" id="exampleInputPassword1" required>
            
            <button type="submit">Sign-In</button>
        </form>
        <a href="/user/signup"><button>Create Account</button></a>
    </div>
</body>
</html>
