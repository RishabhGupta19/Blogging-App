<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
<link rel="icon" href="/favicon.ico" type="image/x-icon">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily-drift</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center; /* Centering content */
            gap: 25px; /* Spacing between cards */
            padding: 20px;
            max-width: 1200px;
            margin: auto;
        }

        .card {
            flex: 1 1 calc(25% - 30px); /* 4 per row */
            max-width: 280px;
            min-width: 250px;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            text-align: center;
            height: 100%;
            padding-bottom: 15px;
            transition: transform 0.3s ease-in-out;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card img {
            padding:5px;
            width: 100%;
            height: 180px;
            object-fit: cover; /* Ensures proper image filling */
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
        }

        .card-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 15px;
            flex-grow: 1;
            width: 100%;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .button-group {
            display: flex;
            gap: 10px; /* Space between buttons */
            justify-content: center;
            width: 100%;
        }

        .btn-primary, .btn-danger {
            width: 100px;
            text-align: center;
            border-radius: 5px;
            padding: 8px 0;
        }

        /* Responsive Fixes */
        @media (max-width: 1024px) {
            .card {
                flex: 1 1 calc(33.33% - 30px); /* 3 per row */
            }
        }

        @media (max-width: 768px) {
            .card {
                flex: 1 1 calc(50% - 30px); /* 2 per row */
            }
        }

        @media (max-width: 480px) {
            .card {
                flex: 1 1 100%; /* 1 per row */
            }
        }
    </style>
</head>
<body>
    <%- include("./partials/script") %>
    <%- include("./partials/nav") %>

    <div class="container mt-3">
        <% blogs.forEach(blog => { %>
            <div class="card">
                <img src="<%= blog.coverImage %>" alt="Blog Cover Image">
                <div class="card-body">
                    <h5 class="card-title"><%= blog.title %></h5>
                    
                    <div class="button-group">
                        <a href="/blog/<%= blog.id %>" class="btn btn-primary">View</a>
                        <% if (user && user.id && blog.createdBy && user.id === blog.createdBy.id) { %>
                            <form action="/blog/delete/<%= blog.id %>" method="post">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</body>
</html>
