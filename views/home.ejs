<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" href="https://res.cloudinary.com/dnm9w3upk/image/upload/v1742154628/favicon_q1zhvh.ico" type="image/x-icon">
    <%- include("./partials/head") %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily-drift</title>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #eef1f5;
            margin: 0;
            padding: 0;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
            padding: 40px;
            max-width: 1300px;
            margin: auto;
        }

        .card {
            flex: 1 1 calc(25% - 30px);
            max-width: 300px;
            min-width: 260px;
            background: linear-gradient(135deg, #ffffff, #f9f9f9);
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            text-align: center;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        }

        .card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .card-body {
            padding: 20px;
        }

        .card-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 15px;
        }

        .button-group {
            display: flex;
            justify-content: center;
            gap: 12px;
        }

        .btn-primary, .btn-danger {
            width: 110px;
            padding: 10px;
            border-radius: 6px;
            font-size: 0.9rem;
            transition: 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #007bff;
            color: #fff;
        }

        .btn-danger:hover {
            background-color: #dc3545;
            color: #fff;
        }

        /* Responsive Fixes */
        @media (max-width: 1024px) {
            .card {
                flex: 1 1 calc(33.33% - 30px);
            }
        }

        @media (max-width: 768px) {
            .card {
                flex: 1 1 calc(50% - 30px);
            }
        }

        @media (max-width: 480px) {
            .card {
                flex: 1 1 100%;
            }
        }
    </style>
</head>
<body>
    <%- include("./partials/script") %>
    <%- include("./partials/nav") %>

    <div class="container mt-3">
        <% blogs.forEach(blog => { %>
            <div class="card">
                <img src="<%= blog.coverImage %>" alt="Blog Cover Image">
                <div class="card-body">
                    <h5 class="card-title"><%= blog.title %></h5>
                    <div class="button-group">
                        <a href="/blog/<%= blog.id %>" class="btn btn-primary">View</a>
                        <% if (user && user.id && blog.createdBy && user.id === blog.createdBy.id) { %>
                            <form action="/blog/delete/<%= blog.id %>" method="post">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</body>
</html>
