<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head")  %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SignUp</title>
    <style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

@keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

@keyframes slideInDown {
    from {
        opacity: 0;
        transform: translateY(-100px) scale(0.8);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-8px); }
    20%, 40%, 60%, 80% { transform: translateX(8px); }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
}

@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(50px) scale(0.9);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

@keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
}

@keyframes glow {
    0%, 100% { 
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.3),
                   0 0 40px rgba(168, 85, 247, 0.2),
                   0 15px 35px rgba(0, 0, 0, 0.3);
    }
    50% { 
        box-shadow: 0 0 30px rgba(59, 130, 246, 0.5),
                   0 0 60px rgba(168, 85, 247, 0.4),
                   0 20px 50px rgba(0, 0, 0, 0.4);
    }
}

@keyframes buttonPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

@keyframes sparkle {
    0%, 100% { opacity: 0; transform: scale(0) rotate(0deg); }
    50% { opacity: 1; transform: scale(1) rotate(180deg); }
}

@keyframes ripple {
    0% {
        transform: scale(0);
        opacity: 1;
    }
    100% {
        transform: scale(4);
        opacity: 0;
    }
}

/* Global Styling */
* {
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', sans-serif !important;
    background: linear-gradient(-45deg, #0f0f23, #1a1a2e, #16213e, #0f3460) !important;
    background-size: 400% 400% !important;
    animation: gradientShift 15s ease infinite;
    margin: 0 !important;
    padding: 0 !important;
    min-height: 100vh !important;
    color: #e2e8f0 !important;
    overflow-x: hidden !important;
}

body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(168, 85, 247, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 40%, rgba(34, 197, 94, 0.08) 0%, transparent 50%);
    pointer-events: none;
    z-index: -1;
}

/* Enhanced Alert Styling */
.alert {
    position: relative !important;
    color: #fff !important;
    background: linear-gradient(135deg, 
        rgba(239, 68, 68, 0.9), 
        rgba(220, 38, 38, 0.9), 
        rgba(185, 28, 28, 0.9)) !important;
    background-size: 200% 200% !important;
    padding: 20px 25px !important;
    border-radius: 15px !important;
    margin: 30px 100px !important;
    font-size: 16px !important;
    font-weight: 500 !important;
    backdrop-filter: blur(20px) !important;
    border: 2px solid rgba(239, 68, 68, 0.5) !important;
    overflow: hidden !important;
    animation: slideInDown 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards,
               gradientShift 3s ease infinite,
               shake 0.5s ease-in-out,
               glow 2s ease-in-out infinite;
    display: flex !important;
    align-items: center !important;
    gap: 15px !important;
    box-shadow: 0 0 20px rgba(239, 68, 68, 0.6),
                0 0 40px rgba(239, 68, 68, 0.4),
                0 15px 35px rgba(0, 0, 0, 0.3) !important;
    transition: all 0.3s ease !important;
}

.alert::before {
    content: '⚠️';
    font-size: 24px;
    animation: sparkle 2s infinite;
    margin-right: 10px;
}

.alert::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, 
        transparent 30%, 
        rgba(255, 255, 255, 0.2) 50%, 
        transparent 70%);
    background-size: 200% 200%;
    animation: shimmer 2s infinite;
    border-radius: 15px;
    z-index: 1;
}

.alert:hover {
    transform: translateY(-5px) scale(1.02) !important;
    box-shadow: 0 0 30px rgba(239, 68, 68, 0.8),
                0 0 50px rgba(239, 68, 68, 0.6),
                0 20px 40px rgba(0, 0, 0, 0.4) !important;
    border-color: rgba(239, 68, 68, 0.8) !important;
}

/* Form Container Enhancement */
form {
    max-width: 500px !important;
    margin: 50px auto !important;
    background: rgba(30, 30, 30, 0.9) !important;
    backdrop-filter: blur(25px) saturate(180%) !important;
    padding: 50px 40px !important;
    border-radius: 25px !important;
    border: 1px solid rgba(59, 130, 246, 0.3) !important;
    position: relative !important;
    animation: slideInUp 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards,
               float 6s ease-in-out infinite,
               glow 4s ease-in-out infinite;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5),
                0 15px 25px rgba(59, 130, 246, 0.1),
                inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
    transition: all 0.3s ease !important;
}

form::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, 
        transparent 30%, 
        rgba(59, 130, 246, 0.05) 50%, 
        transparent 70%);
    background-size: 200% 200%;
    animation: shimmer 3s infinite;
    border-radius: 25px;
    z-index: -1;
}

form::after {
    content: '✨';
    position: absolute;
    top: 20px;
    right: 25px;
    font-size: 1.5rem;
    animation: sparkle 2s infinite;
    z-index: 2;
}

form:hover {
    transform: translateY(-10px) scale(1.02) !important;
    border-color: rgba(59, 130, 246, 0.6) !important;
    box-shadow: 0 35px 70px rgba(0, 0, 0, 0.6),
                0 25px 35px rgba(59, 130, 246, 0.3) !important;
}

/* Form Groups Enhancement */
.mb-3 {
    margin-bottom: 30px !important;
    position: relative !important;
    animation: slideInUp 0.6s ease forwards;
    animation-delay: calc(var(--delay, 0) * 0.1s);
    z-index: 2 !important;
}

.mb-3:nth-child(1) { --delay: 1; }
.mb-3:nth-child(2) { --delay: 2; }
.mb-3:nth-child(3) { --delay: 3; }
.mb-3:nth-child(4) { --delay: 4; }

/* Enhanced Labels */
.form-label {
    font-weight: 600 !important;
    display: block !important;
    margin-bottom: 10px !important;
    color: #cbd5e1 !important;
    font-size: 0.95rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    transition: all 0.3s ease !important;
    font-family: 'Inter', sans-serif !important;
    position: relative !important;
    z-index: 3 !important;
}

/* Enhanced Form Controls */
.form-control {
    width: 100% !important;
    padding: 18px 25px !important;
    border: 2px solid rgba(59, 130, 246, 0.3) !important;
    border-radius: 15px !important;
    font-size: 16px !important;
    background: rgba(40, 40, 40, 0.8) !important;
    color: #e2e8f0 !important;
    backdrop-filter: blur(10px) !important;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    position: relative !important;
    z-index: 2 !important;
    font-family: 'Inter', sans-serif !important;
}

.form-control::placeholder {
    color: #64748b !important;
    transition: all 0.3s ease !important;
}

.form-control:focus {
    outline: none !important;
    border-color: rgba(59, 130, 246, 0.8) !important;
    background: rgba(50, 50, 50, 0.9) !important;
    box-shadow: 0 0 25px rgba(59, 130, 246, 0.3),
                0 10px 20px rgba(0, 0, 0, 0.2) !important;
    transform: translateY(-3px) !important;
}

.form-control:focus::placeholder {
    color: transparent !important;
    transform: translateY(-20px) !important;
}

.form-control:focus + .form-label {
    color: #3b82f6 !important;
    transform: translateY(-2px) !important;
}

/* File Input Enhancement */
input[type="file"].form-control {
    position: relative !important;
    padding: 15px !important;
}

input[type="file"]::file-selector-button {
    background: linear-gradient(45deg, #3b82f6, #8b5cf6) !important;
    color: white !important;
    border: none !important;
    padding: 10px 20px !important;
    border-radius: 10px !important;
    margin-right: 15px !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
    font-weight: 500 !important;
}

input[type="file"]::file-selector-button:hover {
    background: linear-gradient(45deg, #2563eb, #7c3aed) !important;
    transform: scale(1.05) !important;
}

/* Enhanced Submit Button */
.btn {
    width: 100% !important;
    background: linear-gradient(45deg, #3b82f6, #8b5cf6) !important;
    color: white !important;
    border: none !important;
    padding: 20px !important;
    font-size: 18px !important;
    font-weight: 600 !important;
    border-radius: 15px !important;
    cursor: pointer !important;
    margin-top: 30px !important;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
    position: relative !important;
    overflow: hidden !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4) !important;
    animation: slideInUp 0.6s ease 0.5s both;
    z-index: 2 !important;
}

.btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.6s ease;
    z-index: 1;
}

.btn:hover {
    background: linear-gradient(45deg, #2563eb, #7c3aed) !important;
    transform: translateY(-3px) scale(1.02) !important;
    box-shadow: 0 20px 40px rgba(59, 130, 246, 0.6) !important;
    animation: buttonPulse 1s infinite;
}

.btn:hover::before {
    left: 100%;
}

.btn:active {
    transform: translateY(-1px) scale(1.01) !important;
    transition: all 0.1s ease !important;
}

/* Container Div Enhancement */
div[style*="padding:15px"] {
    position: relative !important;
    z-index: 1 !important;
}

/* Responsive Design */
@media (max-width: 768px) {
    form {
        margin: 30px 20px !important;
        padding: 40px 30px !important;
    }

    .alert {
        margin: 20px 20px !important;
    }

    .form-control {
        padding: 15px 20px !important;
    }

    .btn {
        padding: 18px !important;
        font-size: 16px !important;
    }
}

@media (max-width: 480px) {
    form {
        margin: 20px 15px !important;
        padding: 30px 20px !important;
    }

    .alert {
        margin: 15px 15px !important;
        padding: 15px 20px !important;
        font-size: 14px !important;
    }

    .form-control {
        padding: 12px 15px !important;
        font-size: 15px !important;
    }
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
    * {
        animation: none !important;
        transition: none !important;
    }
    
    form {
        animation: slideInUp 0.3s ease forwards !important;
    }

    .alert {
        animation: slideInDown 0.3s ease forwards !important;
    }
}

/* Focus indicators for accessibility */
.btn:focus,
.form-control:focus {
    outline: 2px solid #3b82f6 !important;
    outline-offset: 2px !important;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: rgba(30, 30, 30, 0.8);
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(45deg, #3b82f6, #8b5cf6);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(45deg, #2563eb, #7c3aed);
}
</style>
</head>
<body>
    <%- include("./partials/script")  %>
     <%- include("./partials/navsign")  %> 
    <form action="/user/signup" method="post" enctype="multipart/form-data">
      <% if (error) { %>
        <div class="alert">
            <%= error %>
        </div>
    <% } %>
    
      <div style="padding:15px">
        <div class="mb-3 mt-4 ml-6 mr-6" >
          <label for="fullName" class="form-label">Full Name</label>
          <input type="text" class="form-control" id="fullName" name = "fullName" aria-describedby="fullname">
        </div>
      <div  class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Email address</label>
        <input type="email" class="form-control" id="exampleInputEmail1" name = "email" aria-describedby="emailHelp">
        
      <div  class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Password</label>
        <input type="password" class="form-control" name = "password" id="exampleInputPassword1">
      </div>
      <div  class="mb-3">
        <label for="profilePhoto" class="form-label" style="font-family: Cambria, Cochin, Georgia, Times,">ProfilePhoto</label>
        <input type="file" class="form-control" id="profilePhoto" name="profilePhoto" accept="image/*">
      
      </div>
      <button type="submit" class="btn btn-primary">SignUp</button>
    </form>
      </div>
        
</body>
</html>
