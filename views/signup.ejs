<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SignUp</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes slideInDown {
            from {
                opacity: 0;
                transform: translateY(-100px) scale(0.8);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-8px); }
            20%, 40%, 60%, 80% { transform: translateX(8px); }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(50px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        @keyframes shimmer {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }

        @keyframes glow {
            0%, 100% { 
                box-shadow: 0 0 20px rgba(59, 130, 246, 0.3),
                           0 0 40px rgba(168, 85, 247, 0.2),
                           0 15px 35px rgba(0, 0, 0, 0.3);
            }
            50% { 
                box-shadow: 0 0 30px rgba(59, 130, 246, 0.5),
                           0 0 60px rgba(168, 85, 247, 0.4),
                           0 20px 50px rgba(0, 0, 0, 0.4);
            }
        }

        @keyframes inputFocus {
            0% { width: 0%; }
            100% { width: 100%; }
        }

        @keyframes buttonPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        @keyframes sparkle {
            0%, 100% { opacity: 0; transform: scale(0) rotate(0deg); }
            50% { opacity: 1; transform: scale(1) rotate(180deg); }
        }

        @keyframes typewriter {
            from { width: 0; }
            to { width: 100%; }
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        @keyframes ripple {
            0% {
                transform: scale(0);
                opacity: 1;
            }
            100% {
                transform: scale(4);
                opacity: 0;
            }
        }

        /* Global Styling */
        * {
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(-45deg, #0f0f23, #1a1a2e, #16213e, #0f3460);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            color: #e2e8f0;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 80% 20%, rgba(168, 85, 247, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 40% 40%, rgba(34, 197, 94, 0.08) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

        /* Alert Styling */
        .alert {
            position: relative;
            color: #fff;
            background: linear-gradient(135deg, 
                rgba(239, 68, 68, 0.9), 
                rgba(220, 38, 38, 0.9), 
                rgba(185, 28, 28, 0.9));
            background-size: 200% 200%;
            padding: 20px 25px;
            border-radius: 15px;
            margin: 30px 100px 30px 100px;
            font-size: 16px;
            font-weight: 500;
            backdrop-filter: blur(20px);
            border: 2px solid rgba(239, 68, 68, 0.5);
            overflow: hidden;
            animation: slideInDown 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards,
                       gradientShift 3s ease infinite,
                       shake 0.5s ease-in-out,
                       glow 2s ease-in-out infinite;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.6),
                        0 0 40px rgba(239, 68, 68, 0.4),
                        0 15px 35px rgba(0, 0, 0, 0.3);
        }

        .alert::before {
            content: '⚠️';
            font-size: 24px;
            animation: sparkle 2s infinite;
        }

        .alert::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, 
                transparent 30%, 
                rgba(255, 255, 255, 0.2) 50%, 
                transparent 70%);
            background-size: 200% 200%;
            animation: shimmer 2s infinite;
            border-radius: 15px;
        }

        /* Navigation */
        .navbar {
            background: rgba(30, 30, 30, 0.9);
            backdrop-filter: blur(25px);
            padding: 20px 0;
            border-bottom: 1px solid rgba(59, 130, 246, 0.2);
            animation: slideInDown 0.8s ease forwards;
        }

        /* Form Container */
        .form-container {
            max-width: 500px;
            margin: 50px auto;
            background: rgba(30, 30, 30, 0.9);
            backdrop-filter: blur(25px) saturate(180%);
            padding: 50px 40px;
            border-radius: 25px;
            border: 1px solid rgba(59, 130, 246, 0.3);
            position: relative;
            animation: slideInUp 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards,
                       float 6s ease-in-out infinite,
                       glow 4s ease-in-out infinite;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5),
                        0 15px 25px rgba(59, 130, 246, 0.1),
                        inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, 
                transparent 30%, 
                rgba(59, 130, 246, 0.05) 50%, 
                transparent 70%);
            background-size: 200% 200%;
            animation: shimmer 3s infinite;
            border-radius: 25px;
            z-index: -1;
        }

        .form-container::after {
            content: '✨';
            position: absolute;
            top: 20px;
            right: 25px;
            font-size: 1.5rem;
            animation: sparkle 2s infinite;
            z-index: 2;
        }

        .form-container:hover {
            transform: translateY(-10px) scale(1.02);
            border-color: rgba(59, 130, 246, 0.6);
            box-shadow: 0 35px 70px rgba(0, 0, 0, 0.6),
                        0 25px 35px rgba(59, 130, 246, 0.3);
        }

        /* Form Title */
        .form-title {
            text-align: center;
            margin-bottom: 40px;
            background: linear-gradient(45deg, #3b82f6, #8b5cf6, #06d6a0);
            background-size: 300% 300%;
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientShift 3s ease infinite;
            font-weight: 700;
            font-size: 2.5rem;
            position: relative;
        }

        /* Form Groups */
        .form-group {
            margin-bottom: 30px;
            position: relative;
            animation: slideInUp 0.6s ease forwards;
            animation-delay: calc(var(--delay, 0) * 0.1s);
        }

        .form-group:nth-child(1) { --delay: 1; }
        .form-group:nth-child(2) { --delay: 2; }
        .form-group:nth-child(3) { --delay: 3; }
        .form-group:nth-child(4) { --delay: 4; }

        .form-label {
            font-weight: 600;
            display: block;
            margin-bottom: 10px;
            color: #cbd5e1;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
        }

        .form-control {
            width: 100%;
            padding: 18px 25px;
            border: 2px solid rgba(59, 130, 246, 0.3);
            border-radius: 15px;
            font-size: 16px;
            background: rgba(40, 40, 40, 0.8);
            color: #e2e8f0;
            backdrop-filter: blur(10px);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            z-index: 2;
            font-family: 'Inter', sans-serif;
        }

        .form-control::placeholder {
            color: #64748b;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: rgba(59, 130, 246, 0.8);
            background: rgba(50, 50, 50, 0.9);
            box-shadow: 0 0 25px rgba(59, 130, 246, 0.3),
                        0 10px 20px rgba(0, 0, 0, 0.2);
            transform: translateY(-3px);
        }

        .form-control:focus::placeholder {
            color: transparent;
            transform: translateY(-20px);
        }

        .form-control:focus ~ .form-label {
            color: #3b82f6;
            transform: translateY(-2px);
        }

        /* Input Line Animation */
        .input-line {
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(45deg, #3b82f6, #8b5cf6);
            transform: scaleX(0);
            transition: transform 0.3s ease;
            border-radius: 1px;
        }

        .form-control:focus + .input-line {
            transform: scaleX(1);
        }

        /* File Input Styling */
        input[type="file"] {
            position: relative;
        }

        input[type="file"]::file-selector-button {
            background: linear-gradient(45deg, #3b82f6, #8b5cf6);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            margin-right: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        input[type="file"]::file-selector-button:hover {
            background: linear-gradient(45deg, #2563eb, #7c3aed);
            transform: scale(1.05);
        }

        /* Submit Button */
        .btn {
            width: 100%;
            background: linear-gradient(45deg, #3b82f6, #8b5cf6);
            color: white;
            border: none;
            padding: 20px;
            font-size: 18px;
            font-weight: 600;
            border-radius: 15px;
            cursor: pointer;
            margin-top: 30px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4);
            animation: slideInUp 0.6s ease 0.5s both;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s ease;
        }

        .btn:hover {
            background: linear-gradient(45deg, #2563eb, #7c3aed);
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 20px 40px rgba(59, 130, 246, 0.6);
            animation: buttonPulse 1s infinite;
        }

        .btn:hover::before {
            left: 100%;
        }

        .btn:active {
            transform: translateY(-1px) scale(1.01);
            transition: all 0.1s ease;
        }

        /* Loading Animation */
        .btn.loading {
            position: relative;
            color: transparent;
        }

        .btn.loading::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            margin: auto;
            border: 2px solid transparent;
            border-top: 2px solid #ffffff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        @keyframes spin {
            0% { transform: translate(-50%, -50%) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg); }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .form-container {
                margin: 30px 20px;
                padding: 40px 30px;
            }

            .alert {
                margin: 20px 20px;
            }

            .form-title {
                font-size: 2rem;
            }

            .form-control {
                padding: 15px 20px;
            }

            .btn {
                padding: 18px;
                font-size: 16px;
            }
        }

        @media (max-width: 480px) {
            .form-container {
                margin: 20px 15px;
                padding: 30px 20px;
            }

            .alert {
                margin: 15px 15px;
                padding: 15px 20px;
                font-size: 14px;
            }

            .form-title {
                font-size: 1.8rem;
            }

            .form-control {
                padding: 12px 15px;
                font-size: 15px;
            }
        }

        /* Accessibility */
        @media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
            
            .form-container {
                animation: slideInUp 0.3s ease forwards;
            }

            .alert {
                animation: slideInDown 0.3s ease forwards;
            }
        }

        /* Focus indicators for accessibility */
        .btn:focus,
        .form-control:focus {
            outline: 2px solid #3b82f6;
            outline-offset: 2px;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(30, 30, 30, 0.8);
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(45deg, #3b82f6, #8b5cf6);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(45deg, #2563eb, #7c3aed);
        }
    </style>
</head>
<body>
    <!-- Navigation would go here -->
    <nav class="navbar">
        <!-- Navigation content -->
    </nav>

    <!-- Error Alert (shown conditionally) -->
    <!-- <div class="alert">
        ⚠️ Something went wrong. Please check your information and try again.
    </div> -->

    <!-- Main Form Container -->
    <div class="form-container">
        <h1 class="form-title">Create Account</h1>
        
        <form action="/user/signup" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label for="fullName" class="form-label">Full Name</label>
                <input type="text" class="form-control" id="fullName" name="fullName" placeholder="Enter your full name" aria-describedby="fullname" required>
                <div class="input-line"></div>
            </div>

            <div class="form-group">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email" aria-describedby="emailHelp" required>
                <div class="input-line"></div>
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" name="password" id="password" placeholder="Create a strong password" required>
                <div class="input-line"></div>
            </div>

            <div class="form-group">
                <label for="profilePhoto" class="form-label">Profile Photo</label>
                <input type="file" class="form-control" id="profilePhoto" name="profilePhoto" accept="image/*">
                <div class="input-line"></div>
            </div>

            <button type="submit" class="btn btn-primary" id="submitBtn">Create Account</button>
        </form>
    </div>

    <script>
        // Add interactive functionality
        const form = document.querySelector('form');
        const submitBtn = document.getElementById('submitBtn');
        const inputs = document.querySelectorAll('.form-control');

        // Form submission with loading animation
        form.addEventListener('submit', function(e) {
           // e.preventDefault(); 
            
            // Add loading state
            submitBtn.classList.add('loading');
            submitBtn.textContent = '';
            
            // Simulate API call (remove in production)
            setTimeout(() => {
                submitBtn.classList.remove('loading');
                submitBtn.style.background = 'linear-gradient(45deg, #10b981, #059669)';
                submitBtn.textContent = 'Account Created!';
                
                setTimeout(() => {
                    submitBtn.style.background = 'linear-gradient(45deg, #3b82f6, #8b5cf6)';
                    submitBtn.textContent = 'Create Account';
                }, 2000);
            }, 2000);
        });

        // Add focus animations to inputs
        inputs.forEach((input, index) => {
            input.addEventListener('focus', function() {
                this.parentElement.style.transform = 'scale(1.02)';
                this.parentElement.style.zIndex = '10';
            });
            
            input.addEventListener('blur', function() {
                this.parentElement.style.transform = 'scale(1)';
                this.parentElement.style.zIndex = '1';
            });

            // Stagger input animations
            input.parentElement.style.animationDelay = `${index * 0.1}s`;
        });

        // File input preview
        const fileInput = document.getElementById('profilePhoto');
        fileInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    // Create preview (optional)
                    console.log('File selected:', file.name);
                };
                reader.readAsDataURL(file);
            }
        });

        // Add ripple effect to button
        submitBtn.addEventListener('click', function(e) {
            const ripple = document.createElement('div');
            const rect = this.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            const x = e.clientX - rect.left - size / 2;
            const y = e.clientY - rect.top - size / 2;
            
            ripple.style.cssText = `
                position: absolute;
                width: ${size}px;
                height: ${size}px;
                left: ${x}px;
                top: ${y}px;
                background: rgba(255, 255, 255, 0.3);
                border-radius: 50%;
                transform: scale(0);
                animation: ripple 0.6s ease-out;
                pointer-events: none;
                z-index: 1;
            `;
            
            this.appendChild(ripple);
            
            setTimeout(() => {
                ripple.remove();
            }, 600);
        });

        // Real-time validation (optional)
        const emailInput = document.getElementById('email');
        const passwordInput = document.getElementById('password');
        
        emailInput.addEventListener('input', function() {
            if (this.validity.valid) {
                this.style.borderColor = 'rgba(34, 197, 94, 0.6)';
            } else if (this.value) {
                this.style.borderColor = 'rgba(239, 68, 68, 0.6)';
            }
        });

        passwordInput.addEventListener('input', function() {
            if (this.value.length >= 8) {
                this.style.borderColor = 'rgba(34, 197, 94, 0.6)';
            } else if (this.value) {
                this.style.borderColor = 'rgba(251, 191, 36, 0.6)';
            }
        });

        // Auto-hide alert after 5 seconds
        const alert = document.querySelector('.alert');
        if (alert) {
            setTimeout(() => {
                alert.style.animation = 'slideInDown 0.5s ease reverse';
                alert.style.opacity = '0';
                setTimeout(() => {
                    alert.style.display = 'none';
                }, 500);
            }, 5000);
        }
    </script>
</body>
</html>
